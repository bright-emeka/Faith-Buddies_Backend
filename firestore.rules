rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(resourcePath) {
      return isAuthenticated() && request.auth.uid == resourcePath;
    }

    function isUserResource(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFollowerOf(targetUserId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/follows/$(request.auth.uid)_$(targetUserId));
    }

    function isValidPostContent(content) {
      return content is string && content.size() > 0 && content.size() <= 5000;
    }

    function isValidMessageContent(content) {
      return content is string && content.size() > 0 && content.size() <= 4000;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUserResource(userId)
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.uid == userId;
    }

    match /users/{userId}/feed/{postId} {
      allow read: if isUserResource(userId);
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && isValidPostContent(request.resource.data.content)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['content', 'image', 'updatedAt']);
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /posts/{postId}/likes/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && userId == request.auth.uid
        && resource.data.userId == request.auth.uid;
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && isValidMessageContent(request.resource.data.content)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['content', 'likesCount', 'updatedAt']);
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.followerId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && chatId == request.auth.uid;
      allow create: if isAuthenticated() && chatId == request.auth.uid;
      allow update: if isAuthenticated() && chatId == request.auth.uid;
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isAuthenticated() && chatId == request.auth.uid;
      allow create: if isAuthenticated()
        && chatId == request.auth.uid
        && isValidMessageContent(request.resource.data.content)
        && request.resource.data.role in ['user', 'assistant'];
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}